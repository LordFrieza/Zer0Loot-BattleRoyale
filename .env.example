# Copie ce fichier et exporte ces variables avant « npm start ».
PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-moi
TWITCH_CHANNEL=zer0loot
# Application Twitch (https://dev.twitch.tv/console/apps) pour « Se connecter avec Twitch »
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
PUBLIC_URL=http://localhost:3000
# Optionnel : bot qui répond dans le chat
TWITCH_BOT_USERNAME=
TWITCH_BOT_OAUTH=
# Dossier de sauvegarde (db.json). En ligne : un volume persistant, ex. /data
DATA_DIR=./data
# « production » en ligne : cookies sécurisés, pas de mot de passe admin par défaut, liaison par pseudo désactivée
NODE_ENV=
# 1 pour garder la liaison « par pseudo » (mode test, non vérifiée) même avec l'OAuth Twitch configuré
ALLOW_DEV_LINK=
# 1 pour ne pas se connecter au chat Twitch (tests hors ligne)
TWITCH_CHAT_DISABLED=
